.env
.env.*
*.token
.huggingface/

# ─── Model weights ────────────────────────────────────────────────────────
# Matched by pattern, not by directory name: quantization experiments spawn
# ad-hoc output dirs (models/int8-perchannel/, models/fp16-keepio/, ...) and
# a single stray encoder shard is 2.4 GB.
*.onnx
*.onnx.data
*.onnx_data
*.nemo
*.ckpt
*.pt
*.pth
*.safetensors
*.tflite
*.mlmodel
*.mlpackage/
*.mlmodelc/

# Everything downloaded or generated under models/ is reproducible from
# tools/fetch_model.py + tools/quantize.py.
# Everything under models/ is downloaded or generated; test fixtures live in
# Fixtures/ instead.
models/

# Scratch working set for tools/run_reference.py. Regenerable, and the three
# clips the tests and demo actually use live in Fixtures/.
samples/
